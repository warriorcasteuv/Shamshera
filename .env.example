# Copy to .env for local API development. Never commit real credentials.
# Gmail SMTP requires a Google App Password and a verified "Send mail as" alias.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=LaserSport <support@lasersport.online>
ADMIN_EMAIL=support@lasersport.online
ADMIN_USERNAME=choose_a_private_admin_username
ADMIN_PASSWORD=replace_with_a_strong_password_at_least_12_characters
# Optional: If the frontend is hosted separately, set this to the public API origin.
# Example: https://lasersport-api.onrender.com
API_ORIGIN=
