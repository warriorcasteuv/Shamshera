{
  "name": "orixbet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx server.ts",
    "start:api": "node --env-file-if-exists=.env --import tsx server.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && vite build",
    "test": "tsx --test tests/*.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^5.3.0",
    "nodemailer": "^10.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "typescript": "~5.8.2",
    "vite": "^5.4.19"
  }
}
